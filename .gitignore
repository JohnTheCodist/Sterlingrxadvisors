node_modules

# Real secrets never ship. .env.example is the opposite: it is the reference
# for what has to be set on a host, carries placeholders only, and is useless
# to anyone deploying if git hides it.
.env
server/.env
client/.env
relay/.env
!.env.example
server/rxnaija.db
server/rxnaija.db-shm
server/rxnaija.db-wal

# Runtime state, not source. These are leftovers from the pre-Postgres
# JSON-file era (fact-store.json alone is ~28 MB) plus downloaded NCDC
# report PDFs — all regenerated at runtime and read by no code today.
server/data/
server/storage/
# Desktop installers — build artefacts, rebuilt via "cd desktop && npm run dist".
# A 78MB binary per release would bloat the repo permanently.
releases/

# Runtime scratch: cached uploads (services/lastUploadStore.js) and multer's
# streaming target for in-flight uploads. Both are regenerated and neither
# should ever reach a deploy.
tmp/
