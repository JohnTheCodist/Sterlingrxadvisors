# SterlingRx Advisors — environment reference
#
# Copy the SERVER block to server/.env and the CLIENT block to client/.env,
# or set them in cPanel under "Setup Node.js App > Environment variables".
# Never commit a filled-in copy: server/.env and client/.env are gitignored
# and must stay that way.
#
# Startup validates this. Missing REQUIRED values stop the process with a
# message naming each one; missing optional values only log which feature is
# switched off. See server/config/env.js.


# ============================================================================
#  SERVER  ->  server/.env
# ============================================================================

# ---- REQUIRED. The app refuses to start without these three. ----

# Postgres connection string.
# Supabase > Project Settings > Database > Connection string > Session pooler.
# Use the SESSION pooler, not the transaction pooler: this app relies on
# prepared statements, which the transaction pooler does not support.
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres

# Supabase project URL.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Supabase service role key. Server-side only — it bypasses row-level security.
# If this ever reaches the browser bundle, rotate it immediately.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ---- Port ----
# Leave UNSET in production. cPanel/Passenger assigns the port and the app
# reads process.env.PORT. Set it only to override the local default of 4000.
# PORT=4000

# Set to "production" on the live host. Tightens the API rate limit and lets
# Express skip development-only work.
NODE_ENV=production

# ---- AI. Absent = column mapping falls back to heuristics and Lume is off. ----
LLM_API_KEY=
LLM_API_URL=https://api.deepseek.com/v1/chat/completions
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_MS=30000
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0

# Advisor tuning. Every one of these has a working default — set them only to
# change behaviour deliberately.
# ADVISOR_MODEL=
# ADVISOR_MAX_TOKENS=
# ADVISOR_MAX_REQUEST_MS=
# ADVISOR_STALL_TIMEOUT_MS=
# ADVISOR_MAX_RETRIES=
# ADVISOR_MAX_CONTINUATIONS=
# ADVISOR_THINKING=

# ---- WhatsApp via Twilio. Absent = the channel is off; the rest still works. ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Absolute, publicly reachable base URL. Twilio calls back here and PDF links
# are built from it, so a tunnel address left over from local testing means
# every WhatsApp report link points at a machine that is no longer listening.
PUBLIC_BASE_URL=https://app.sterlingrxadvisors.com

# WHATSAPP_PDF_LINK_TTL_MINUTES=60
# WHATSAPP_HISTORY_TURNS=10

# ---- Weather signals. Absent = weather-driven demand insight is skipped. ----
OPENWEATHER_API_KEY=
# OPENWEATHER_API_URL=
# OPENWEATHER_TIMEOUT_MS=

# ---- Desktop installer download ----
# Absolute path to the directory holding SterlingRx-Setup-*.exe. Defaults to
# <repo>/releases. The download page reports "unavailable" rather than 404ing
# when no build is present, so leaving this unset is safe.
# RELEASES_DIR=/home/USER/sterlingrx/releases

# Set to true ONLY once the installer is genuinely code-signed. It drives a
# warning on the download page about the SmartScreen prompt an unsigned build
# triggers — claiming signed when it is not means users meet that screen with
# no warning and assume the file is malware.
DESKTOP_BUILD_SIGNED=false


# ============================================================================
#  CLIENT  ->  client/.env
# ============================================================================
#
# BUILD-TIME, not runtime. Vite inlines these into the bundle, so they must be
# present when `npm run build` runs — setting them on the server afterwards
# does nothing. Rebuild after changing either.
#
# Both are safe to expose: the anon key is the publishable one, and row-level
# security is what actually protects the data.

VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# Leave EMPTY for the website. Empty keeps API paths relative ("/api/..."),
# which is correct when one Express process serves both the API and the site.
# Only the desktop build sets it, and it does so automatically at build time.
# VITE_API_BASE_URL=


# ============================================================================
#  RELAY  ->  relay/.env   (optional service; only if desktop apps use AI)
# ============================================================================
# Credential broker so desktop installs never ship an LLM key. Not needed to
# run the website.
#
# LLM_API_KEY=
# LLM_API_URL=
# LLM_MODEL=
# PORT=4310
# NGN_PER_USD=
# RATE_INPUT_PER_M=
# RATE_OUTPUT_PER_M=
# RATE_CACHED_INPUT_PER_M=
