{
  "name": "rxnaija-desktop",
  "productName": "RxNaija Analytics",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop shell for RxNaija Analytics — same product, own window.",
  "main": "main.js",
  "scripts": {
    "build:renderer": "node scripts/build-renderer.js",
    "dev": "electron .",
    "start": "npm run build:renderer && electron .",
    "dist": "npm run build:renderer && electron-builder --win --publish never",
    "dist:portable": "npm run build:renderer && electron-builder --win portable --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.rxnaija.analytics",
    "productName": "RxNaija Analytics",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "renderer/**/*",
      "build/icon.*"
    ],
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] }
      ],
      "artifactName": "RxNaija-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "RxNaija Analytics"
    }
  }
}
