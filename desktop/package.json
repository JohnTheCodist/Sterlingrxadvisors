{
  "name": "sterlingrx-desktop",
  "productName": "SterlingRx Advisors",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop shell for SterlingRx Advisors — same product, own window.",
  "main": "main.js",
  "scripts": {
    "build:renderer": "node scripts/build-renderer.js",
    "dev": "electron .",
    "start": "npm run build:renderer && electron . --force-renderer",
    "icon": "electron scripts/make-icon.js",
    "verify": "electron scripts/smoke-test.js",
    "verify:live": "electron scripts/verify-live.js",
    "screenshot": "electron scripts/screenshot.js",
    "dist": "npm run build:renderer && electron-builder --win --publish never",
    "dist:portable": "npm run build:renderer && electron-builder --win portable --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.sterlingrx.advisors",
    "productName": "SterlingRx Advisors",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "renderer/**/*",
      "build/icon.*"
    ],
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] }
      ],
      "artifactName": "SterlingRx-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SterlingRx Advisors"
    }
  }
}
