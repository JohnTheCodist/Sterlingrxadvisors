# SterlingRx Advisors — Environment Configuration
# Copy this file to .env and fill in values.

# ---- LLM Column Mapping (Phase 2) ----
# OpenAI-compatible API for AI-powered column mapping.
# Leave blank to use rule-based local mode.
LLM_API_KEY=
LLM_API_URL=
LLM_MODEL=gpt-4o-mini
# Applies to column mapping and one-shot analysis only — NOT the AI Advisor.
# Keep this tight: a slow mapping call should fall back to rule-based mode
# quickly rather than stalling an upload.
LLM_TIMEOUT_MS=15000
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.1

# ---- AI Advisor (streaming chat) ----
# Deliberately separate from the values above. The Advisor streams long
# answers over several tool-calling round trips, so it needs a far more
# forgiving budget than a single short mapping call.
# Stall timeout: time with NO bytes received before giving up. It RESETS on
# every chunk, so a stream that is actively delivering is never cut off —
# only a genuinely stalled connection trips it.
ADVISOR_STALL_TIMEOUT_MS=60000
# Absolute ceiling for one request, so a never-ending stream still ends.
ADVISOR_MAX_REQUEST_MS=180000
# Retries on connection-level faults only (never on a 4xx), and only while
# nothing has been streamed to the user yet.
ADVISOR_MAX_RETRIES=2
# Answer length cap. 1024 truncates consulting-style answers mid-sentence.
ADVISOR_MAX_TOKENS=2048

# ---- Weather Intelligence (seasonal demand signals) ----
# OpenWeather current-weather API. Leave blank to disable — the app runs
# normally without it, just without weather-driven recommendations.
OPENWEATHER_API_KEY=
OPENWEATHER_API_URL=https://api.openweathermap.org/data/2.5/weather
OPENWEATHER_TIMEOUT_MS=10000

# ---- Supabase (multi-tenant auth + Postgres) ----
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# ---- WhatsApp (Twilio) ----
# Leave blank to disable — the app runs normally without it, just without
# the WhatsApp channel. See the Twilio console for Account SID/Auth Token,
# and the WhatsApp Sandbox (dev) or an approved Business number (prod).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
# Public origin Twilio can reach, e.g. https://api.sterlingrx.app — needed so
# /pdf/whatsapp/:id links are fetchable. Local dev needs a tunnel (ngrok etc).
PUBLIC_BASE_URL=
WHATSAPP_PDF_LINK_TTL_MINUTES=30
WHATSAPP_HISTORY_TURNS=20

# ---- Server ----
PORT=4000
